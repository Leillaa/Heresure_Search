# [RU] путь к psql, если он не в PATH (нужен только для send_campaign.py/parser.py)
# PG_BIN=/usr/bin/psql

# --- [EN] HTTP Basic Auth for the web page (app.py) — NOT used yet ---
# The site is currently open to anyone with the link (no login/password).
# If you need to lock down access, uncomment and enter your own
# "login:password" pairs separated by commas, then restart the service
# (systemctl restart agent-licence).
# --- [RU] HTTP Basic Auth для веб-страницы (app.py) — пока НЕ используется ---
# Сайт сейчас открыт всем, у кого есть ссылка (без логина/пароля).
# Если понадобится закрыть доступ — раскомментируйте и впишите свои
# "логин:пароль" через запятую, перезапустите сервис (systemctl restart agent-licence).
# BASIC_AUTH_USERS=alice:change_me,bob:change_me

