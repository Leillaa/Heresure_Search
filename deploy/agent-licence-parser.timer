[Unit]
Description=Ежедневный запуск agent-licence-parser в 9:00 по Нью-Йорку

[Timer]
# Часовой пояс прямо в спецификации — systemd сам учитывает переход
# на летнее/зимнее время (EST/EDT), в отличие от обычного cron с TZ=.
OnCalendar=*-*-* 09:00:00 America/New_York
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
