[Unit]
Description=Agent Licence viewer (Flask/gunicorn)
After=network.target postgresql.service

[Service]
Type=exec
User=agentapp
Group=agentapp
WorkingDirectory=/opt/agent_licence
EnvironmentFile=/opt/agent_licence/.env
ExecStart=/opt/agent_licence/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/agent_licence
ProtectHome=true

[Install]
WantedBy=multi-user.target
