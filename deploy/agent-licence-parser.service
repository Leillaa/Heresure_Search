[Unit]
Description=Agent Licence daily parser (download the FL DFS registry, filter, load new agents / скачать реестр FL DFS, отфильтровать, догрузить новых агентов)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=agentapp
Group=agentapp
WorkingDirectory=/opt/agent_licence
EnvironmentFile=/opt/agent_licence/.env
ExecStart=/opt/agent_licence/.venv/bin/python3 -m scripts.parser
TimeoutStartSec=3600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/agent_licence
ProtectHome=true
